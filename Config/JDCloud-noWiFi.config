#京东云亚瑟 RE-SS-01 / AX1800 Pro —— 无 WiFi 版
#硬件：IPQ6000，1GB 硬改内存 + 64GB eMMC，带 USB 口
#本份只写「亚瑟特有」的东西；两台共用的在 Config/GENERAL.config。
#加载顺序：本文件 → GENERAL.config → Settings.sh 注入 → make defconfig
#（GENERAL 是后加载的，会覆盖本层 —— 想关掉通用层的包只能在通用层改。）

#======================= 设备平台 =======================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
#只列亚瑟一台，列了别的机型会一起编进固件包。同系批次名需要时再打开：
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y

#======================= 无线驱动：整条关掉 =======================
#必须显式 =n：ipq60xx 的 DEFAULT_PACKAGES 自带 ath11k 与固件，只注释掉等于用 target 默认值。
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n
#无线用户态也关掉：wpad-openssl / hostapd-common 在 target 的 DEFAULT_PACKAGES 里，
#不显式 =n 就会白装两个常驻进程（实测 M2 上 hostapd + wpa_supplicant 一直在跑）。
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_hostapd-common=n

#======================= 存储与文件共享（只有亚瑟有 eMMC + USB 口）=======================
CONFIG_PACKAGE_luci-app-mini-diskmanager=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-samba4=y
#automount：插 U 盘自动挂载。已在机型层显式钉住（M2 那边 =n），不靠 target 默认值。
CONFIG_PACKAGE_automount=y
#磁盘工具：这三个原本挂在 iStore 段（quickstart 脚本要用），取消 iStore 后按用途归入本段。
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
#文件系统模块（2026-10-20 补）：之前只有 exfat 的用户态工具、没有内核模块，盘根本挂不上。
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
#不装：kmod-fs-ntfs3（没有 NTFS 盘）、kmod-fs-f2fs（eMMC 由分区表直接管）
#CONFIG_PACKAGE_kmod-fs-ntfs3=y
#CONFIG_PACKAGE_kmod-fs-f2fs=y

#======================= 外设接口模块（只有亚瑟有 USB / 可接盘）=======================
#2026-10-20 从 GENERAL.config 下放：M2 没有 USB / SATA / NVMe，装这些纯占内核体积，
#  而且它们不少在 target 的 DEFAULT_PACKAGES 里，M2 那边必须显式 =n 才真的关得住
#  （见 Config/ZNM2-noWiFi.config 的「关掉用不上的外设」段）。
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-audio=y
CONFIG_PACKAGE_kmod-sound-core=y
#USB 网卡 / 4G 网卡驱动（接 USB 网卡当 WAN、或插 4G 棒时用）
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
#SATA / NVMe
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_libnvme=y
CONFIG_PACKAGE_mmc-utils=y
#工具
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usb-modeswitch=y
#iPhone USB 网络共享
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_libimobiledevice=y
#samba 的内核态加速（跟存储段的 luci-app-samba4 配套）
CONFIG_PACKAGE_kmod-fs-ksmbd=y

#======================= UPnP =======================
#只有本机是 NAT 网关（主路由）时才生效，所以只给亚瑟；M2 是旁路由，装了没用。
#★两行都要写：luci-app-upnp 的 DEPENDS 只带 +miniupnpd，不写就是「菜单在、守护进程不在」。
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y

#======================= 实用插件 =======================
#★lucky / adguardhome / vlmcsd / easytier 全部写成 =m（2026-10-23 改）：
#  不进固件镜像，但照样编译出 apk 发布在 Release 里，刷完按需要再装 ——
#  固件瘦身、又不丢「想用就能装」的余地。装完 rm -f /tmp/luci-indexcache* 刷新菜单。
#  依赖不会自动进固件（DEPENDS 生成的依赖同是 =m），离线装要连依赖的 apk 一起装。
#lucky：DDNS / 反代 / 端口转发（打洞部分在 NAT3~NAT4 下不可用，不用管）
CONFIG_PACKAGE_lucky=m
CONFIG_PACKAGE_luci-app-lucky=m
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=m
#adguardhome：本地 DNS + 去广告（主程序二进制不在固件里，避免两个 init.d 抢 53 端口）
CONFIG_PACKAGE_luci-app-adguardhome=m
CONFIG_PACKAGE_adguardhome=m
#eMMC 健康：64GB eMMC，看寿命 / 健康度 / Pre-EOL。体积小，直接进固件。
CONFIG_PACKAGE_luci-app-emmc-health=y
#vlmcsd：KMS 服务，给局域网 Windows / Office 激活用
CONFIG_PACKAGE_vlmcsd=m
CONFIG_PACKAGE_luci-app-vlmcsd=m
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=m

#======================= 组网：EasyTier =======================
#异地组网（打不通自动走中继）。主程序是未 strip 的 Rust 二进制（40~70MB），所以不进固件。
#★界面 + 主程序 + 中文包三行都要写（界面包的 LUCI_DEPENDS 并不依赖主程序）。
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

#======================= Docker（只有亚瑟装：1GB 内存 + 64GB eMMC）=======================
#源码来自 XiaoHaiSly/luci-app-dockerman（Scripts/Packages.sh 里拉）。
#★整套都要显式写 =y：DEPENDS 生成的是 depends on，Kconfig 只保证「下限」，
#  依赖会被提到 =m（编成 ipk 丢进 bin/packages、不进固件镜像），刷完机器上等于没装。
#  依赖清单的基准是 XiaoHaiSly 那份 v29.9.1 的 dockerd/Makefile，别拿上游 v29.6.1 对表。
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-lib-docker=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_iptables-nft=y
#dockerd 的硬依赖（同样是 =y 才进镜像）：
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_fuse-overlayfs=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_libseccomp=y
#fuse-overlayfs 是实测踩出来的：/opt/docker 里记着上一任存储驱动 = fuse-overlayfs，
#缺这个二进制时 dockerd 不会回退 overlay2，直接拒绝启动。
#装好后建议清一次 /opt/docker，让 dockerd 按默认优先级挑 overlay2（性能更好）。
#★不装：kmod-ipt-nat / kmod-ipt-nat6 / kmod-ipt-physdev / iptables-mod-extra
#  （老 xtables 模块，v29.9.1 走 nftables 后端，装了也不会被调用）；
#  ip6tables / kmod-nf-conntrack-netlink（未启用 IPv6；conntrack-netlink 是 conntrackd 用的）；
#  nftables（该符号不存在，主干只有 nftables-json / nftables-nojson 变体）。

#======================= Docker 需要的内核开关 ========================
#这几项目标内核默认全是 not set，不开的话 dockerd 起不来（cgroup / namespace 报错）。
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_KMEM=y
CONFIG_KERNEL_MEMCG_V1=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_CPUSETS_V1=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_PIDS=y
#CGROUP_HUGETLB：2026-10-20 删掉。它依赖 HUGETLBFS，而 6.18 的 generic config 里
#  HUGETLBFS 是 not set → 写了也不生效（父项不通，内核 oldconfig 会把它丢掉）。
#CONFIG_KERNEL_CGROUP_HUGETLB=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_CGROUP_NET_CLASSID=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_BLK_CGROUP=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_POSIX_MQUEUE=y
CONFIG_KERNEL_KEYS=y
CONFIG_KERNEL_EXT4_FS_SECURITY=y
CONFIG_KERNEL_CFS_BANDWIDTH=y
CONFIG_KERNEL_FAIR_GROUP_SCHED=y
CONFIG_KERNEL_RT_GROUP_SCHED=y
#★不写 DOCKER_OPTIONAL_FEATURES（参考配置里有，别抄）：它 select 的 MEMCG_SWAP_ENABLED 和
#  CFQ_GROUP_IOSCHED 在 6.x 内核已不存在，CGROUP_PERF 的父项 PERF_EVENTS 也是 not set。

#======================= 镜像分区 =======================
#★CONFIG_TARGET_ROOTFS_PARTSIZE 在亚瑟身上不生效，别写：它 depends on
#  USES_ROOTFS_PART || TARGET_ROOTFS_EXT4FS，而亚瑟是 EmmcImage（squashfs + eMMC），
#  两个条件都不满足 → 符号不可见，写了会被 defconfig 静默丢掉。
#  64GB eMMC 也用不着它：镜像按分区表直接写入，没有那个 104MB 限制。
#CONFIG_TARGET_ROOTFS_PARTSIZE=512
#（INITRAMFS 保持默认 n：只在救砖 / 大分区 U-Boot 直刷时才用；SQUASHFS 是 target 默认，不用写。）

#======================= 已停用 / 明确不要 ========================
#iStore + QuickStart 整套（2026-10-20 停用：用了几版发现实际用处不大，且拖进一堆依赖）：
#CONFIG_PACKAGE_luci-app-istorex=y
#CONFIG_PACKAGE_luci-app-quickstart=y
#CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y
#CONFIG_PACKAGE_quickstart=y
#CONFIG_PACKAGE_luci-app-store=y
#CONFIG_PACKAGE_taskd=y
#CONFIG_PACKAGE_luci-lib-taskd=y
#CONFIG_PACKAGE_luci-lib-xterm=y
#CONFIG_PACKAGE_luci-app-ttyd=y
#CONFIG_PACKAGE_ttyd=y
#CONFIG_PACKAGE_bash=y
#CONFIG_PACKAGE_mount-utils=y
#CONFIG_PACKAGE_smartd=y
#CONFIG_PACKAGE_shadow-utils=y
#CONFIG_PACKAGE_shadow-useradd=y

#SQM：2026-10-20 删除（抗 Bufferbloat）。开了 NSS 硬件加速后流量不过软件队列，本来就只对
#  走软件转发的那部分流量生效。
#CONFIG_PACKAGE_luci-app-sqm=y
#CONFIG_PACKAGE_sqm-scripts=y
#CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

#OAF 应用过滤（2026-10-17 停用）：kmod-oaf 递归依赖选不上；out-of-tree 模块跟内核强相关；
#  且 NSS 开启后流量不过 netfilter 钩子，装上也是失效的。恢复需同时打开 Packages.sh 那段。
#CONFIG_PACKAGE_luci-app-oaf=y
#CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
#CONFIG_PACKAGE_appfilter=y

#quickfile（2026-10-18 停用）：它会把 luci-nginx → nginx 拉进来，LuCI 站点默认 443 + 自签
#  证书 + 80 跳 443，浏览器就会弹 https 不安全提示。去掉后 LuCI 回落到 uhttpd。
#CONFIG_PACKAGE_luci-app-quickfile=y
#nginx 兜底：防别的包再把 luci-nginx 拉回来（=n 挡不住 select，那种情况要改对应包的 Makefile）
CONFIG_PACKAGE_luci-nginx=n
CONFIG_PACKAGE_nginx=n
CONFIG_PACKAGE_nginx-util=n
CONFIG_PACKAGE_uwsgi=n
CONFIG_PACKAGE_uhttpd=y

#其它明确不要的：
#CONFIG_PACKAGE_luci-app-passwall=y       # 科学插件统一走 nikki
#CONFIG_PACKAGE_luci-app-mosdns=y         # DNS 不叠第二套
#CONFIG_PACKAGE_luci-app-smartdns=y
#CONFIG_PACKAGE_luci-app-cupsd=y          # 没有 USB 打印机
#CONFIG_PACKAGE_cups=y
#CONFIG_PACKAGE_luci-app-pbr=y            # 单 WAN 用不到策略路由
#CONFIG_PACKAGE_luci-app-athena-led=y     # 雅典娜专属，不是这台机器
