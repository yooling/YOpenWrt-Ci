#京东云亚瑟 RE-SS-01 / AX1800 Pro —— 无 WiFi 版
#
#硬件：IPQ6000，1GB 硬改内存 + 64GB eMMC，带 USB 口
#本份只写「亚瑟特有」的东西；两台机器共用的在 Config/GENERAL.config。
#加载顺序：本文件 → GENERAL.config → Settings.sh 注入 → make defconfig
#（后加载的覆盖先加载的，所以本层想关掉 GENERA 里的 =y 是关不住的，
#  真要关只能在 GENERA 那层改 —— 这也是那几个存储类包下放到这里的原因。）

#设备平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
#设备列表
#亚瑟就是这一台。其余机型一律不列 —— 列了就会一起编进固件包，体积和编译时间都翻倍。
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
#京东云同系（同一份硬件的不同批次名），需要时把对应行行首的 # 去掉：
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y

#WIFI驱动
#本份是无 WiFi 版：本机当纯有线主路由用，无线栈整条关掉。
#★必须显式 =n：ipq60xx 的 DEFAULT_PACKAGES 里自带 ath11k 与固件，
#  只把行注释掉等于用 target 的默认值，驱动照样进固件。
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n

#======================= 存储类：只有带 eMMC 的亚瑟才装 =======================
#★这三个原本在上游 GENERAL.txt 里，本仓库把它们下放到这一层：
#  兆能 M2 是 128MB NAND、既没有 USB 口也没有外接盘位，装这些纯占空间；
#  亚瑟是 64GB eMMC + USB 口，才是它们真正有用的地方。
#  （放在机型层的另一个好处：谁要谁不要在同一份文件里一次决定，
#    不会再出现「GENERA 后加载把机型层的 =n 反向覆盖回 =y」那种问题。）
#mini-diskmanager：磁盘分区 / 格式化 / 挂载管理
CONFIG_PACKAGE_luci-app-mini-diskmanager=y
#partexp：分区扩容。eMMC 有 64G，出厂只用前几 G，靠它把剩余空间扩进根分区
CONFIG_PACKAGE_luci-app-partexp=y
#samba4：文件共享。接 U 盘 / 移动硬盘时给内网做 SMB 共享
CONFIG_PACKAGE_luci-app-samba4=y

#======================= iStore / QuickStart：只有亚瑟装 =======================
#成品界面就是 https://<路由>/cgi-bin/luci/admin/quickstart/ 那一页：
#  QuickStart 仪表盘 / NetworkGuide 网络向导 / NetworkPort 网口配置，
#  再加 iStoreX 首页和 iStore 商店。（结构参考 ZqinKing 的成品，源码线仍用本仓库那三条。）
#★结构：luci-app-istorex 是入口，它的 LUCI_DEPENDS 是
#    +luci-app-quickstart +luci-app-store +luci-lib-taskd
#  所以理论上只写 istorex 一行就能把整套带出来 —— 但依赖带出来的是 =m
#  （编成包、不进固件镜像），刷完菜单里根本看不到。
#  所以下面每一项都显式写成 =y。
#  另外 quickstart（后端）和 luci-app-quickstart（界面）是两个包，都得写。
#★为什么只给亚瑟：quickstart 是常驻后台进程 + 预编译二进制，
#  而且下面这批里好几个是磁盘 / eMMC / 存储向的。兆能 M2 是 512MB 内存 + 128MB NAND、
#  没有 USB 口也没有盘位，既不划算也用不上 —— 所以一行都不进 GENERAL.config。

#---- iStore 商店 + 快速向导 ----
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
#ttyd：网页版终端。luci-app-quickstart 的 LUCI_DEPENDS 里写着 +luci-app-ttyd，
#  iStore 装软件时的进度输出也走它。
#  ★两个都得写：只写界面那一项的话，主程序 ttyd 会被依赖带成 =m（不进固件），
#    点开终端就是一片空白。
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
#quickstart 后端（quickstart 这个包）的 DEPENDS 里挂着一批命令行工具，
#  按上面的道理它们也只会是 =m —— 缺了的话向导页会在运行中报错（脚本解释器、
#  查磁盘、挂载、建用户都靠它们）。亚瑟空间富余，这里一并钉成 y：
#  bash        —— 它的几个脚本是 bash 写的（OpenWrt 默认只有 ash）
#  block-mount / mount-utils / lsblk / blkid —— 查盘、挂载
#  e2fsprogs / parted    —— 格式化、分区（RAID / 存储向导要用）
#  smartd / smartmontools-drivedb —— S.M.A.R.T. 那一页
#  shadow-utils / shadow-useradd —— 建系统用户
#  （lsblk / blkid / smartmontools / smartmontools-drivedb / ip-full 通用层已经是 y 了。）
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_smartd=y
CONFIG_PACKAGE_shadow-utils=y
CONFIG_PACKAGE_shadow-useradd=y

#---- 其它（ZqinKing 成品里有、我们也用得上的）----
#lucky：DDNS / 反代 / 端口转发 / Stun 打洞 的大杂烩。
#  这里主要用它的 DDNS 和反代；打洞那部分在家宽 NAT3~NAT4 下不可用（同 natmap 的结论），忽略。
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
#adguardhome：本地 DNS + 去广告。
#  ★默认不把二进制编进固件（CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary 默认 n），
#    界面会在首次配置时联网下载 —— 保持默认是有意的：
#    一旦开成 y，adguardhome 包的 /etc/init.d/adguardhome 会和界面的
#    /etc/init.d/AdGuardHome 并存，容易起两个实例抢 53 端口。
#    真要离线可用（比如刷完不想联网），把
#    CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary=y 加到本段即可。
CONFIG_PACKAGE_luci-app-adguardhome=y
#eMMC 健康：亚瑟是 64GB eMMC，看寿命 / 健康度 / Pre-EOL 有意义
CONFIG_PACKAGE_luci-app-emmc-health=y
#oaf：应用过滤（按 App 特征限速 / 拦截）。★已停用，三条理由（2026-10-17 TEST 实证）：
#  1) 内核模块选不上 —— defconfig 报 "symbol PACKAGE_kmod-oaf is selected by
#     PACKAGE_kmod-oaf" 递归依赖，kconfig 判为 broken 后不再传播 select，
#     最终结果就是 CONFIG_PACKAGE_kmod-oaf "is not set"：界面在、模块不在，功能必然残废。
#  2) oaf 是 out-of-tree 内核模块，跟内核版本强相关，6.18 / 6.12 都有编不过的风险。
#  3) 就算装上了，NSS 硬件加速开启时流量走硬件转发、不过 netfilter 钩子，功能本身就失效。
#★恢复方法：取消下面三行注释，并取消 Scripts/Packages.sh 里 OpenAppFilter 那段的注释
#  （两处必须一起改，否则选中源码树里不存在的包会在 apk 阶段直接中断编译）。
#CONFIG_PACKAGE_luci-app-oaf=y
#CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
#CONFIG_PACKAGE_appfilter=y
#sqm：智能队列管理，抗 Bufferbloat。亚瑟当主路由时用得上。
#  （同样提醒：NSS 硬件加速开启时 SQM 只在走软件转发的流量上生效。）
#  sqm-scripts 是真正的限速脚本，界面只是配它的 —— 同样要显式写 y。
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
#vlmcsd：KMS 服务，给局域网里的 Windows / Office 激活用
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
#quickfile：临时文件分享
#★2026-10-18 禁用 —— 它是「后台地址弹 https 不安全提示」的元凶，链路如下：
#    luci-app-quickfile 的 LUCI_DEPENDS 是 "+luci-nginx +quickfile"（上游 Makefile 第 6 行）
#      → luci-nginx → nginx + nginx-util + uwsgi
#      → 连带再拖进 python3 glib2 libffi libical libmaxminddb libxslt sqlite3 bluez
#      → nginx 的 LuCI 站点模板默认监听 443 + 自签证书，并把 80 重定向过去
#      → 浏览器访问 192.168.51.100 被跳到 https，弹红色不安全提示
#  日志实证：16 日版（无提示）nginx 只到 feeds 扫描，从未 download/compile；
#            17 日版（有提示）出现了 nginx / nginx-util / luci-nginx / uwsgi 四处 compile。
#  去除后 nginx 不再被拉入，LuCI 回落到 uhttpd（两版都编了 uhttpd），恢复成 16 日的表现。
#  恢复方法：把下面这行改回 =y，并同步取消 Scripts/Packages.sh 里 UPDATE_PACKAGE "quickfile"
#            那行的注释；届时若要消除 https 提示，需另改 nginx 站点模板。
#CONFIG_PACKAGE_luci-app-quickfile=y

#★nginx 兜底（2026-10-18 加）：即便将来别的包再把 luci-nginx 拉进来，这里也先钉死。
#  注意 Kconfig 语义：=n 只能挡「没被别的包 select」的情况；若某包写了 select 仍会被拉起，
#  那种情况要去改那个包的 Makefile，不是加 =n 能解决的。
CONFIG_PACKAGE_luci-nginx=n
CONFIG_PACKAGE_nginx=n
CONFIG_PACKAGE_nginx-util=n
CONFIG_PACKAGE_uwsgi=n
#uhttpd：去掉 nginx 后由它提供 LuCI，显式钉 =y 防止将来被顶掉
CONFIG_PACKAGE_uhttpd=y
#automount：插 U 盘自动挂载。亚瑟有 USB 口，插盘即用。
#  （GENERAL.config 里已经是 =y，这里再写一遍是显式确认亚瑟需要它 —— 通用层的 =y
#    覆盖不了机型层，但反过来写一遍能让「谁要谁不要」在这份文件里一次看全。）
CONFIG_PACKAGE_automount=y

#======================= 组网：只有亚瑟装 =======================
#easytier：异地组网（打洞成功就点对点、打不通自动走中继），远程访问家里设备用。
#  为什么是它而不是 natmap：本机家宽是 NAT3~NAT4、无公网 IPv6，纯打洞类方案（natmap /
#  Lucky STUN）根本打不通，只能走「打不通自动中继」的组网路线。
#★为什么三行都要写（这是踩过的坑）：
#  luci-app-easytier 的 LUCI_DEPENDS 只有 +kmod-tun +luci-compat，没有依赖主程序 ——
#  只写界面那行，编出来是「菜单在、easytier-core 不在」，点了完全没用。
#  2026-10-17 的 TEST 实证：CONFIG_PACKAGE_easytier 是 "is not set"，
#  而 CONFIG_PACKAGE_luci-app-easytier=y —— 正是这个症状。主程序必须显式写 =y。
#★为什么只在亚瑟：主程序是未 strip 的 Rust 二进制（40~70MB），M2 的 128MB NAND 装不下。
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_easytier=y

#★明确不要的（ZqinKing 成品里有，按要求剔除。留成注释防止以后又加回来）：
#CONFIG_PACKAGE_luci-app-passwall=y       # 科学插件已统一走 nikki，不叠第二套
#CONFIG_PACKAGE_luci-app-mosdns=y         # DNS 已有其它方案，不叠
#CONFIG_PACKAGE_luci-app-smartdns=y
#CONFIG_PACKAGE_luci-app-cupsd=y          # 打印服务器：家里没有 USB 打印机
#CONFIG_PACKAGE_cups=y
#CONFIG_PACKAGE_luci-app-pbr=y            # 策略路由：单 WAN 场景用不到
#CONFIG_PACKAGE_luci-app-athena-led=y     # 京东云雅典娜专属，亚瑟不是那台机器

#======================= Docker：也只有亚瑟装 =======================
#★为什么写在这一层而不是 GENERAL.config：
#  兆能 M2 是 512MB 内存 + 128MB NAND，dockerd 自己就要吃掉一大截内存，跑不了几个容器；
#  亚瑟是 1GB 内存 + 64GB eMMC，才有它的用武之地。GENERAL 是两台共用的，不能放。
#源码来自 XiaoHaiSly/luci-app-dockerman（Scripts/Packages.sh 里拉的那份）。
#★整套都要显式写 =y，不能只写入口那一项：
#  OpenWrt 的 DEPENDS 在 Kconfig 里生成的是 **depends on**（不是 select），
#  而 Kconfig 对 depends on 只保证「下限」—— 你写 A=y，它把依赖的 B 提到 **=m** 就够了。
#  =m 只是编成一个 ipk 丢进 bin/packages，**不会打进固件镜像**，刷完机器里根本没有 docker。
#  所以下面每一项都手动钉成 y。
#dockerd：守护进程本体
CONFIG_PACKAGE_dockerd=y
#docker：命令行客户端（docker ps / docker run 这些）
CONFIG_PACKAGE_docker=y
#containerd / runc：容器运行时，dockerd 底下真正拉起容器的两层
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
#luci-lib-docker：界面读 docker 状态用的库
CONFIG_PACKAGE_luci-lib-docker=y
#tini：dockerd 用它当容器的 1 号进程（dockerd 的 Makefile 里有 tini 版本校验）
CONFIG_PACKAGE_tini=y
#nftables-json：v29 dockerd 走的是 nftables 后端，靠它下发规则
CONFIG_PACKAGE_nftables-json=y
#界面
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
#docker-compose：用 yaml 起多容器（比如一次性拉起某套服务）。不用就注释掉，能省不少编译时间。
CONFIG_PACKAGE_docker-compose=y
#iptables-nft：docker 做端口映射时调的是 iptables 命令，fw4 环境下对应 nft 后端这个包，
#  不装的话容器能起来但 -p 端口映射不生效。
CONFIG_PACKAGE_iptables-nft=y
#kmod-macvlan：容器直接拿局域网 IP 时用得上（容器要被局域网其他设备直接访问时）。
CONFIG_PACKAGE_kmod-macvlan=y

#★依赖判定（2026-10-19 重写）
#★基准必须是「实际编进去的那份 dockerd」：XiaoHaiSly/luci-app-dockerman 的 dockerd/Makefile
#  （v29.9.1）。⚠️别拿上游 openwrt/packages 那份（v29.6.1）对表 —— 两者依赖完全不同：
#  上游那份还挂着 +iptables +iptables-mod-extra +kmod-ipt-nat +kmod-ipt-physdev，
#  而 v29.9.1 那份已经全部去掉了。ZqinKing 的 fragments/docker_deps.config 里还保留着那几个
#  老模块，是按旧版本清单写的，别照抄。
#
#  v29.9.1 的 DEPENDS 原文（本次判定依据）：
#      +ca-certificates +containerd +nftables-json +KERNEL_SECCOMP:libseccomp
#      +kmod-nf-nat +kmod-nf-ipvs +kmod-veth +tini +uci-firewall
#
#★下面三项是当时漏钉的。Kconfig 对 depends on 只保证「下限」，不显式写 =y 就会退化成 =m，
#  编成独立包丢进 bin/packages、**不进固件镜像** —— 刷完机器上等于没装。
CONFIG_PACKAGE_ca-certificates=y
#  ca-certificates —— 硬依赖。缺了它 docker pull 走 HTTPS 拉镜像会 TLS 校验证书失败。
CONFIG_PACKAGE_uci-firewall=y
#  uci-firewall    —— 硬依赖。dockerd 靠它往 firewall 里写容器规则。
CONFIG_PACKAGE_fuse-overlayfs=y
#  fuse-overlayfs  —— 见下面那段说明（这是 docker 起不来的直接原因）。
#
#  kmod-nf-ipvs / kmod-br-netfilter / libseccomp：前面已开，这里保留便于一眼看全。
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_libseccomp=y

#★fuse-overlayfs（2026-10-19 加 —— 推翻 10-17 那条判断）
#  10-17 这里原本写着「只有 rootless（非 root 跑 docker）才需要，我们用 root 跑，不加」，
#  ⚠️**这条是错的**，实测被 logread 打脸（刷入后 docker 守护进程起不来）：
#      exec: "fuse-overlayfs": executable file not found in $PATH  storage-driver=fuse-overlayfs
#      [graphdriver] prior storage driver fuse-overlayfs failed: driver not supported
#      failed to start daemon: error initializing graphdriver: driver not supported
#  原理：/opt/docker 里记着「上一任存储驱动 = fuse-overlayfs」，但固件里没编这个二进制；
#  而 dockerd 检测到驱动不支持时**不会自动回退到 overlay2**，直接拒绝启动。
#  所以必须编进去（ZqinKing 的 docker_deps.config 里确实也带了它，他那条是对的）。
#★配套动作：装好后在设备上清空 /opt/docker（用户已确认 docker 无保留数据）：
#      /etc/init.d/dockerd stop && rm -rf /opt/docker/* && /etc/init.d/dockerd start
#  清空后 dockerd 会按默认优先级挑驱动，overlay2 排在 fuse-overlayfs 前面 ——
#  既能起来，又能拿到 overlay2 的性能；fuse-overlayfs 只留作兜底，平时用不到。

#★确认不装的（别再被别的清单带偏，理由都在上面）：
#  kmod-ipt-nat / kmod-ipt-nat6 / kmod-ipt-physdev / iptables-mod-extra
#    —— 老 xtables 模块。v29.9.1 的 DEPENDS 里根本没有它们，装了也不会被调用，纯占内核体积。
#  ip6tables / kmod-ipt-nat6（IPV6 条件依赖）
#    —— 本仓未启用 IPv6（17 日构建日志里无任何 ip6 相关编译），条件不满足，装了没用。
#  nftables —— 这个符号本身不存在：主干只有 nftables-json 和 nftables-nojson 两个变体，
#              写了会被 defconfig 静默丢掉。真正需要的 nftables-json 前面已开。
#  btrfs 那串 kmod-lib-* / kmod-crypto-*
#    —— GENERAL.config 已开 kmod-fs-btrfs=y，会被自动带出来，不用手写。

#★内核必须开这几项，否则容器根本起不来（2026-10-16 核对 target/linux/generic/config-6.18：
#  NAMESPACES / CGROUPS / SECCOMP / POSIX_MQUEUE 这些默认全是 "is not set"，
#  不开的话 dockerd 启动就会报 cgroup / namespace 相关的错）。
#  CONFIG_KERNEL_* 是 OpenWrt 的内核开关，会覆盖 target 默认 kernel config。
#  亚瑟的内核分区是 6144k，这几项加起来几百 KB，装得下。
#  （这几项只在本文件里，M2 那条线的编译不会加载到，不受影响。）
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_KMEM=y
CONFIG_KERNEL_MEMCG_V1=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_CPUSETS_V1=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_HUGETLB=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_CGROUP_NET_CLASSID=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_BLK_CGROUP=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_POSIX_MQUEUE=y
CONFIG_KERNEL_KEYS=y
CONFIG_KERNEL_EXT4_FS_SECURITY=y
CONFIG_KERNEL_CFS_BANDWIDTH=y
CONFIG_KERNEL_FAIR_GROUP_SCHED=y
CONFIG_KERNEL_RT_GROUP_SCHED=y

#★关于 rootfs 分区大小：这一行已经注释掉了，因为它在亚瑟身上根本不生效。
#  原本担心：docker 整套进固件后 rootfs 到一两百 MB，而默认 rootfs 分区只有小几十 MB，
#  打包时 pad-rootfs 会报「rootfs 太大」中断编译 —— 所以写了 512。
#  实际查证（2026-10-17 TEST 实证）：CONFIG_TARGET_ROOTFS_PARTSIZE 在生成的 .config 里
#  **完全不存在**，被 defconfig 静默丢掉了。原因是它在 Config-images.in 里写着
#      depends on USES_ROOTFS_PART || TARGET_ROOTFS_EXT4FS
#  而亚瑟是 EmmcImage，这两个条件一个都不满足（用的是 squashfs + eMMC，不是 ext4 分区），
#  符号直接不可见 —— 写了也白写，属于死配置。
#  而且对 64GB eMMC 来说也不需要它：eMMC 镜像是按分区表直接写入的，没有那个 104MB 限制。
#★留着是因为：万一以后换走 ext4 的机型（那时符号就生效了），取消注释即可。
#  真遇到「rootfs 太大」报错，正确的解法也不是改这一行，而是给设备定义里的分区表扩容。
#CONFIG_TARGET_ROOTFS_PARTSIZE=512
