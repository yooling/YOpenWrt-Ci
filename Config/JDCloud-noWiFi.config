#京东云亚瑟 RE-SS-01 / AX1800 Pro —— 无 WiFi 版
#
#硬件：IPQ6000，1GB 硬改内存 + 64GB eMMC，带 USB 口
#本份只写「亚瑟特有」的东西；两台机器共用的在 Config/GENERAL.config。
#加载顺序：本文件 → GENERAL.config → Settings.sh 注入 → make defconfig
#（后加载的覆盖先加载的，所以本层想关掉 GENERA 里的 =y 是关不住的，
#  真要关只能在 GENERA 那层改 —— 这也是那几个存储类包下放到这里的原因。）

#设备平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
#设备列表
#亚瑟就是这一台。其余机型一律不列 —— 列了就会一起编进固件包，体积和编译时间都翻倍。
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
#京东云同系（同一份硬件的不同批次名），需要时把对应行行首的 # 去掉：
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y

#WIFI驱动
#本份是无 WiFi 版：本机当纯有线主路由用，无线栈整条关掉。
#★必须显式 =n：ipq60xx 的 DEFAULT_PACKAGES 里自带 ath11k 与固件，
#  只把行注释掉等于用 target 的默认值，驱动照样进固件。
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n

#======================= 存储类：只有带 eMMC 的亚瑟才装 =======================
#★这三个原本在上游 GENERAL.txt 里，本仓库把它们下放到这一层：
#  兆能 M2 是 128MB NAND、既没有 USB 口也没有外接盘位，装这些纯占空间；
#  亚瑟是 64GB eMMC + USB 口，才是它们真正有用的地方。
#  （放在机型层的另一个好处：谁要谁不要在同一份文件里一次决定，
#    不会再出现「GENERA 后加载把机型层的 =n 反向覆盖回 =y」那种问题。）
#mini-diskmanager：磁盘分区 / 格式化 / 挂载管理
CONFIG_PACKAGE_luci-app-mini-diskmanager=y
#partexp：分区扩容。eMMC 有 64G，出厂只用前几 G，靠它把剩余空间扩进根分区
CONFIG_PACKAGE_luci-app-partexp=y
#samba4：文件共享。接 U 盘 / 移动硬盘时给内网做 SMB 共享
CONFIG_PACKAGE_luci-app-samba4=y
