#京东云亚瑟 RE-SS-01 / AX1800 Pro —— 无 WiFi 版
#
#硬件：IPQ6000，1GB 硬改内存 + 64GB eMMC，带 USB 口
#本份只写「亚瑟特有」的东西；两台机器共用的在 Config/GENERAL.config。
#加载顺序：本文件 → GENERAL.config → Settings.sh 注入 → make defconfig
#（后加载的覆盖先加载的，所以本层想关掉 GENERA 里的 =y 是关不住的，
#  真要关只能在 GENERA 那层改 —— 这也是那几个存储类包下放到这里的原因。）

#设备平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
#设备列表
#亚瑟就是这一台。其余机型一律不列 —— 列了就会一起编进固件包，体积和编译时间都翻倍。
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
#京东云同系（同一份硬件的不同批次名），需要时把对应行行首的 # 去掉：
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y

#WIFI驱动
#本份是无 WiFi 版：本机当纯有线主路由用，无线栈整条关掉。
#★必须显式 =n：ipq60xx 的 DEFAULT_PACKAGES 里自带 ath11k 与固件，
#  只把行注释掉等于用 target 的默认值，驱动照样进固件。
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n

#======================= 存储类：只有带 eMMC 的亚瑟才装 =======================
#★这三个原本在上游 GENERAL.txt 里，本仓库把它们下放到这一层：
#  兆能 M2 是 128MB NAND、既没有 USB 口也没有外接盘位，装这些纯占空间；
#  亚瑟是 64GB eMMC + USB 口，才是它们真正有用的地方。
#  （放在机型层的另一个好处：谁要谁不要在同一份文件里一次决定，
#    不会再出现「GENERA 后加载把机型层的 =n 反向覆盖回 =y」那种问题。）
#mini-diskmanager：磁盘分区 / 格式化 / 挂载管理
CONFIG_PACKAGE_luci-app-mini-diskmanager=y
#partexp：分区扩容。eMMC 有 64G，出厂只用前几 G，靠它把剩余空间扩进根分区
CONFIG_PACKAGE_luci-app-partexp=y
#samba4：文件共享。接 U 盘 / 移动硬盘时给内网做 SMB 共享
CONFIG_PACKAGE_luci-app-samba4=y

#======================= Docker：也只有亚瑟装 =======================
#★为什么写在这一层而不是 GENERAL.config：
#  兆能 M2 是 512MB 内存 + 128MB NAND，dockerd 自己就要吃掉一大截内存，跑不了几个容器；
#  亚瑟是 1GB 内存 + 64GB eMMC，才有它的用武之地。GENERAL 是两台共用的，不能放。
#源码来自 XiaoHaiSly/luci-app-dockerman（Scripts/Packages.sh 里拉的那份）。
#  整套是配套的（dockerd 守护进程 / docker 命令行 / containerd / runc / 界面），
#  这里只需要选界面那一项，其余会按依赖自动跟着进固件；
#  下面几项是依赖链里没有、但用起来会缺的，单独补上。
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
#docker-compose：用 yaml 起多容器（比如一次性拉起某套服务）。不用就注释掉，能省不少编译时间。
CONFIG_PACKAGE_docker-compose=y
#iptables-nft：docker 做端口映射时调的是 iptables 命令，fw4 环境下对应 nft 后端这个包，
#  不装的话容器能起来但 -p 端口映射不生效。
CONFIG_PACKAGE_iptables-nft=y
#kmod-macvlan：容器直接拿局域网 IP 时用得上（容器要被局域网其他设备直接访问时）。
CONFIG_PACKAGE_kmod-macvlan=y

#★内核必须开这几项，否则容器根本起不来（2026-10-16 核对 target/linux/generic/config-6.18：
#  NAMESPACES / CGROUPS / SECCOMP / POSIX_MQUEUE 这些默认全是 "is not set"，
#  不开的话 dockerd 启动就会报 cgroup / namespace 相关的错）。
#  CONFIG_KERNEL_* 是 OpenWrt 的内核开关，会覆盖 target 默认 kernel config。
#  亚瑟的内核分区是 6144k，这几项加起来几百 KB，装得下。
#  （这几项只在本文件里，M2 那条线的编译不会加载到，不受影响。）
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_KMEM=y
CONFIG_KERNEL_MEMCG_V1=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_CPUSETS_V1=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_HUGETLB=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_CGROUP_NET_CLASSID=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_BLK_CGROUP=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_POSIX_MQUEUE=y
CONFIG_KERNEL_KEYS=y
CONFIG_KERNEL_EXT4_FS_SECURITY=y
CONFIG_KERNEL_CFS_BANDWIDTH=y
CONFIG_KERNEL_FAIR_GROUP_SCHED=y
CONFIG_KERNEL_RT_GROUP_SCHED=y

#★固件变大后的配套调整：
#  dockerd + docker + containerd + runc + compose 进固件后，rootfs 会到一两百 MB，
#  默认的 rootfs 分区只有 104MB —— 打包时 pad-rootfs 会直接报「rootfs 太大」而中断编译。
#  亚瑟是 64GB eMMC，给到 512MB 很宽裕；后续想再扩可以用 partexp。
#  （M2 是 128MB NAND，不能跟着改，所以这一行只写在亚瑟这份配置里。）
CONFIG_TARGET_ROOTFS_PARTSIZE=512
