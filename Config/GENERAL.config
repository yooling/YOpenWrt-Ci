CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-proto-relay=y

#---- 停用 ----
#  luci-app-cpufreq，等于编了个没法调的后端。恢复时本行 + luci-app-cpufreq 一起加。
#CONFIG_PACKAGE_cpufreq=y
#stuntman-client：NATMAP 配套的 STUN 客户端，主功能停用，一并关掉。
CONFIG_PACKAGE_stuntman-client=n
