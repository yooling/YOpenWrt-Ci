#兆能 ZN-M2（zn_m2）—— 无 WiFi 版
#硬件：IPQ6000，512MB 内存 + 128MB NAND，无 WiFi、无 USB 口
#本份只写「M2 特有」的东西；两台共用的在 Config/GENERAL.config。
#加载顺序：本文件 → GENERAL.config → Settings.sh 注入 → make defconfig

#======================= 设备平台 =======================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

#======================= 无线驱动：整条关掉 =======================
#必须显式 =n：ipq60xx 的 DEFAULT_PACKAGES 自带 ath11k 与固件，
#只注释掉等于用 target 默认值，驱动照样进固件。
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n

#======================= zram：512MB 内存的低内存保护 =======================
#拿一部分内存当压缩交换盘，避免跑 nikki 时被 OOM 杀进程（代价是压缩的 CPU 开销，
#四核 A53 + NSS 硬件转发扛得住）。亚瑟 1GB 内存暂不需要。
#★三行缺一不可：不指定压缩算法时内核会回退到 lzo，而 kmod-lib-lzo 是条件 DEPENDS、
#  只会是 =m（不进固件）→ zram 加载时找不到算法、设备起不来，所以这里直接点名 lz4。
#  内核的 CONFIG_ZRAM 由 kmod-zram 的 KCONFIG 自动打开，不用手写 CONFIG_KERNEL_ZRAM。
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y