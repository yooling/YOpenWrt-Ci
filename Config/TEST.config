#设备平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
#设备列表
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_cmcc_mr3000d-ci=y
#测试配置：只出 .config、不编译固件（WRT-TEST 工作流里 TEST 默认 true）。
#它是「自包含」的一份 —— WRT-CORE 判定配置名含 test 时只加载本文件、不再叠加 GENERAL.config，
#所以本文件里带着一份 GENERAL 的完整副本。改 GENERAL.config 时记得这里同步，
#否则测出来的配置跟真编的不一样。
#★已与 GENERAL.config 同步过的改动：关 homeproxy、加 nikki、
#  存储三件套（diskmanager / partexp / samba4）下放到 JDCloud-noWiFi.config、去掉 gecoosac、
#  停用 natmapt + stuntman-client、加 DDNSTO（主程序 + 界面 + 中文包）、
#  NetWiz 移到 ZNM2-noWiFi.config（亚瑟改用 quickstart 的 NetworkGuide，两台不再是同一套）、
#  EasyTier 整套移到 JDCloud-noWiFi.config（主程序体积太大，M2 装不下）。
#  （Docker / iStore / EasyTier 不用同步 —— 都是亚瑟独有的，只写在 Config/JDCloud-noWiFi.config。）
#  （下面这一段就是 GENERAL.config 「增加插件」段的副本，改那边时整段照搬过来。）
#科学插件调整
CONFIG_PACKAGE_luci-app-homeproxy=n

#======================= 增加插件 =======================
#---- 科学上网 ----
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

#---- 组网 ----
#（网络向导不在通用层：亚瑟用 quickstart 的 NetworkGuide、M2 用 NetWiz，见各自机型配置。）
#（EasyTier 也不在通用层：只给亚瑟，见 Config/JDCloud-noWiFi.config 的「组网」段。）
CONFIG_PACKAGE_luci-app-natmapt=n

#---- 远程访问 / 内网穿透 ----
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

#---- 日常工具 ----
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wolultra=y

#删除插件
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_luci-app-wol=n
#参数调整
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_FEED_video=n
CONFIG_FEED_pon_drivers=n
CONFIG_FEED_pon_userspace=n
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
#内核调整
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-dsa=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
